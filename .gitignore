# Whitelist .gitignore: ignore EVERYTHING by default, then re-include only
# the files/dirs we ship. Anything new that isn't listed here is ignored,
# so scratch files and secrets can't accidentally get committed.

*

# Root files we ship
!.env.example
!.gitattributes
!.gitignore
!.python-version
!LICENSE
!README.md
!channel_config.json
!pcore.cmd
!pyproject.toml
!uv.lock

# Source tree
!src/
!src/**
src/__pycache__/
src/**/__pycache__/

# Lavalink: config only (jar + jre + plugins + logs stay local)
!lavalink/
!lavalink/**
lavalink/Lavalink.jar
lavalink/*.jar.bak
lavalink/*.jar.new
lavalink/jre/
lavalink/plugins/
lavalink/logs/
