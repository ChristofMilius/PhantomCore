# Discord bot credentials
TOKEN=your-bot-token
GUILD_ID=1234567890123456789
OWNER_ID=1234567890123456789
BOT_ID=1234567890123456789

# Channel IDs (bot-section category)
BOT_CHANNEL=1234567890123456789
BOT_STATUS_CHANNEL=1234567890123456789

# Comma-separated list of cogs to load at startup
# EXTENSIONS=dynamic_lobbies,rename_lobby,purge_commands,pull_commands,extension_helper,llm_module,stalker_player

# Data directory (runtime state: lobbies.db, chat_histories)
# DATA_DIR=data

# LM Studio
LMSTUDIO_HOST=localhost:1234
LMSTUDIO_MODEL=qwen/qwen3-coder-30b
# LMSTUDIO_TEMPERATURE=1.0
# LMSTUDIO_TOP_K=0.5
# LMSTUDIO_MIN_P=0.3
# LMSTUDIO_TOP_P=0.95
# LMSTUDIO_MAX_TOKENS=1024
# LMSTUDIO_CONTEXT_LENGTH=8192
SYSTEM_PROMPT=You are the PhantomCore Discord bot. Be concise, witty, and helpful.

# Lavalink / StalkerPlayer
# LAVALINK_HOST=127.0.0.1:7867
# LAVALINK_PASSWORD=changeme        # REQUIRED, no default; injected into the server the bot boots
# JAVA_PATH=C:\path\to\java.exe            # default: <project>/lavalink/jre/bin/java.exe, else `java` on PATH
# STALKER_CHANNEL=1234567890123456789      # optional; where the music panel gets posted, defaults to command channel
# CLAIM_TIME=300